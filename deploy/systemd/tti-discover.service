[Unit]
Description=time-to-index: poll sources for newly published facts
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/time-to-index
EnvironmentFile=/opt/time-to-index/.env
ExecStart=/opt/time-to-index/.venv/bin/python -m tti discover
# A source being unreachable exits 2. That is a partial run, not a failed one.
SuccessExitStatus=0 2
