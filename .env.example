# Provider keys. Any provider whose key is absent is skipped, not simulated.
PARALLEL_API_KEY=
EXA_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=

# Raises the GitHub releases collector from 60 to 5,000 requests/hour.
GITHUB_TOKEN=

# SEC fair-access and arXiv both ask for a real contact in the User-Agent.
TTI_USER_AGENT=your-name your@email.example
